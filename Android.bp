soong_namespace {
}

android_app_import {
	name: "OnePlusCamera",
	owner: "oneplus",
	apk: "proprietary/product/priv-app/OnePlusCamera/OnePlusCamera.apk",
	certificate: "platform",
        overrides: ["Camera2"],
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
	product_specific: true,
}

android_app_import {
	name: "OnePlusCameraService",
	owner: "oneplus",
	apk: "proprietary/product/priv-app/OnePlusCameraService/OnePlusCameraService.apk",
	certificate: "platform",
	privileged: true,
	product_specific: true,
}

android_app_import {
	name: "OnePlusGallery",
	owner: "oneplus",
	apk: "proprietary/product/priv-app/OnePlusGallery/OnePlusGallery.apk",
	certificate: "platform",
	privileged: true,
	product_specific: true,
}
